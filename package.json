{
  "name": "fidelis-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "DATABASE_URL=postgresql://prisma:prisma@127.0.0.1:5432/fidelis prisma validate",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && PLAYWRIGHT_WEB_SERVER='npm run start -- --hostname 127.0.0.1 --port 3100' playwright test",
    "test:e2e:headed": "npm run build && PLAYWRIGHT_WEB_SERVER='npm run start -- --hostname 127.0.0.1 --port 3100' playwright test --headed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.0.0",
    "cva": "^0.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^3.26.5",
    "openai": "^7.1.0",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.22",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
