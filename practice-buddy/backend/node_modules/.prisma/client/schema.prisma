// AEEG Test Prep Practice Buddy - Database Schema
// Shared backend for Website, Android, iOS, and Windows

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum Difficulty {
  easy
  medium
  hard
  mixed
  adaptive
}

enum QuestionFormat {
  multipleChoice
  studentProducedResponse
  multiSelect
}

enum ContentOwner {
  original
  authorized
  licensed
  internalUse
  rightsVerificationRequired
  rewritingRequired
  retired
}

enum RightsStatus {
  original
  authorized
  licensed
  pending
  prohibited
}

enum QualityStatus {
  draft
  inReview
  approved
  rejected
}

enum PublicationStatus {
  draft
  editorialReview
  technicalReview
  accessibilityReview
  approved
  scheduled
  active
  suspended
  retired
}

enum UserRole {
  student
  centerStudent
  paidStudent
  freeStudent
  teacher
  seniorTeacher
  curriculumEditor
  contentReviewer
  parent
  schoolCoordinator
  administrator
  superAdministrator
}

enum CodeType {
  singleUse
  multiUse
  school
  center
  teacher
  course
  trial
  premium
  featureSpecific
}

enum PlanType {
  student
  teacher
  parent
  family
  school
  institutional
  custom
}

enum BillingCycle {
  monthly
  annual
  oneTime
}

enum SubscriptionStatus {
  active
  trialing
  pastDue
  canceled
  expired
}

enum SeatStatus {
  active
  suspended
  expired
  pending
}

enum ManagedRelationship {
  teacher
  parent
  guardian
  schoolCoordinator
  center
}

enum SessionType {
  targeted
  quick
  random
  adaptive
  simulation
  assignment
  review
}

enum SessionStatus {
  inProgress
  paused
  completed
  abandoned
  expired
}

enum AssignmentType {
  targetedPractice
  fullTest
  module
  remediation
  review
  custom
}

enum AssignmentStatus {
  pending
  inProgress
  completed
  overdue
}

enum FlagType {
  error
  typo
  unclear
  missingContent
  formatting
  accessibility
  copyright
  other
}

enum FlagStatus {
  pending
  reviewing
  resolved
  dismissed
}

enum MasteryLevel {
  notAssessed
  beginning
  developing
  approaching
  mastered
  needsReview
}

// =============================================
// ENTERPRISE ENUMS
// =============================================

enum ExamType {
  SAT
  ACT
  IELTS
  TOEFL
  Academic
  Math
}

enum SubmissionType {
  speaking
  writing
}

enum ReviewStatus {
  pending
  reviewed
  approved
  returned
}

enum AnalyticsType {
  student
  teacher
  parent
  admin
  school
}

enum SubscriptionLicenseType {
  individual
  family
  teacher
  school
  institutional
}

enum SubscriptionLicenseStatus {
  active
  expired
  canceled
  suspended
}

// =============================================
// EXAM & CONTENT HIERARCHY
// =============================================

model Exam {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    Subject[]
  questions   Question[]
  diagnostics DiagnosticResult[]
  mockExams   MockExam[]
}

model Subject {
  id          String   @id @default(cuid())
  examId      String
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam        Exam               @relation(fields: [examId], references: [id])
  domains     Domain[]
  questions   Question[]
  diagnostics DiagnosticResult[]

  @@unique([examId, code])
}

model Domain {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject    Subject    @relation(fields: [subjectId], references: [id])
  categories Category[]
  questions  Question[]

  @@unique([subjectId, code])
}

model Category {
  id          String   @id @default(cuid())
  domainId    String
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain        Domain        @relation(fields: [domainId], references: [id])
  subcategories Subcategory[]
  questions     Question[]
  microSkills   MicroSkill[]

  @@unique([domainId, code])
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id])
  questions Question[]

  @@unique([categoryId, code])
}

// =============================================
// ENTERPRISE: MICRO-SKILLS & LEARNING OBJECTS
// =============================================

model MicroSkill {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        Category           @relation(fields: [categoryId], references: [id])
  questions       Question[]
  learningObjects LearningObject[]
  diagnostics     DiagnosticResult[]
  mastery         Mastery[]

  @@unique([categoryId, code])
}

model LearningObject {
  id                   String   @id @default(cuid())
  microSkillId         String
  title                String
  objective            String
  lesson               String // HTML-safe lesson content
  examples             Json? // [{ "title": "...", "content": "..." }]
  guidedExamples       Json? // [{ "title": "...", "steps": [...] }]
  commonMisconceptions Json? // [{ "misconception": "...", "correction": "..." }]
  teachingStrategies   Json? // [{ "strategy": "...", "description": "..." }]
  teacherNotes         String?
  parentNotes          String?
  remediation          String?
  extensionActivities  Json? // [{ "title": "...", "instructions": "..." }]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  microSkill MicroSkill @relation(fields: [microSkillId], references: [id])
}

// =============================================
// QUESTIONS
// =============================================

model Question {
  id                    String            @id @default(cuid())
  aeeqId                String            @unique // AEEG-SAT-RW-WIC-000001
  version               Int               @default(1)
  examId                String
  subjectId             String
  domainId              String
  categoryId            String
  subcategoryId         String?
  microSkillId          String?
  microSkill            String?
  difficulty            Difficulty        @default(medium)
  difficultyConfidence  Float?            @default(1.0)
  questionFormat        QuestionFormat    @default(multipleChoice)
  passageType           String? // literary, informational, paired, etc.
  passageText           String? // HTML-safe passage text
  pairedPassageText     String? // HTML-safe paired passage
  passageAttribution    String? // source attribution
  questionStem          String // HTML-safe question text
  answerOptions         Json? // [{ "id": "A", "text": "..." }, ...]
  correctAnswer         String // "A" or "3.14" for student-produced
  acceptedResponses     Json? // ["3.14", "22/7"] for math responses
  firstAttemptStrategy  String? // displayed after first attempt
  firstAttemptHint      String? // hint after wrong first attempt
  shortExplanation      String? // concise explanation
  expandedExplanation   String? // detailed explanation
  solutionSteps         Json? // step-by-step solution
  wrongAnswerRationales Json? // why each wrong answer is wrong
  commonMisconceptions  String? // likely misconceptions
  estimatedTime         Int? // seconds
  calculatorAllowed     Boolean           @default(false)
  desmosRecommended     Boolean           @default(false)
  figureAsset           String? // URL to figure/diagram
  figureAltText         String? // accessible alt text
  isPaired              Boolean           @default(false)
  hasChart              Boolean           @default(false)
  hasTable              Boolean           @default(false)
  hasEquation           Boolean           @default(false)
  author                String?
  reviewer              String?
  source                String?
  contentOwner          ContentOwner      @default(original)
  rightsStatus          RightsStatus      @default(original)
  qualityStatus         QualityStatus     @default(draft)
  publicationStatus     PublicationStatus @default(draft)
  editorNotes           String?
  reviewNotes           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  publishedAt           DateTime?
  retiredAt             DateTime?

  exam               Exam         @relation(fields: [examId], references: [id])
  subject            Subject      @relation(fields: [subjectId], references: [id])
  domain             Domain       @relation(fields: [domainId], references: [id])
  category           Category     @relation(fields: [categoryId], references: [id])
  subcategory        Subcategory? @relation(fields: [subcategoryId], references: [id])
  microSkillRelation MicroSkill?  @relation(fields: [microSkillId], references: [id])

  questionVersions QuestionVersion[]
  studentAttempts  StudentAttempt[]
  assignments      AssignmentQuestion[]
  bookmarks        Bookmark[]
  flagReports      QuestionFlag[]
  similarQuestions SimilarQuestion[]    @relation("SimilarQuestions")
  similarTo        SimilarQuestion[]    @relation("SimilarTo")
}

model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String
  version    Int
  snapshot   Json // full question snapshot at this version
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
}

// =============================================
// SIMILAR QUESTIONS
// =============================================

model SimilarQuestion {
  id                String   @id @default(cuid())
  questionId        String
  similarQuestionId String
  relationship      String   @default("same_skill") // same_skill, retry, remediation
  createdAt         DateTime @default(now())

  question        Question @relation("SimilarQuestions", fields: [questionId], references: [id])
  similarQuestion Question @relation("SimilarTo", fields: [similarQuestionId], references: [id])

  @@unique([questionId, similarQuestionId])
}

// =============================================
// ACCESS CODES
// =============================================

model AccessCode {
  id              String    @id @default(cuid())
  code            String    @unique
  codeType        CodeType  @default(premium)
  description     String?
  maxUses         Int? // null = unlimited
  currentUses     Int       @default(0)
  maxUsers        Int? // null = unlimited
  startDate       DateTime  @default(now())
  endDate         DateTime?
  isActive        Boolean   @default(true)
  allowedExams    Json? // ["SAT", "ACT"]
  allowedFeatures Json? // ["full_tests", "ai_tutoring"]
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions AccessCodeRedemption[]
}

model AccessCodeRedemption {
  id           String   @id @default(cuid())
  accessCodeId String
  userId       String
  redeemedAt   DateTime @default(now())

  accessCode AccessCode @relation(fields: [accessCodeId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([accessCodeId, userId])
}

// =============================================
// SUBSCRIPTION PLANS & ENTITLEMENTS
// =============================================

model SubscriptionPlan {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String        @unique
  description  String?
  planType     PlanType      @default(student)
  maxStudents  Int? // null = unlimited
  price        Float?
  billingCycle BillingCycle?
  isActive     Boolean       @default(true)
  features     Json // feature flags
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id           String             @id @default(cuid())
  planId       String
  ownerId      String // who pays
  status       SubscriptionStatus @default(active)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndDate DateTime?
  canceledAt   DateTime?
  stripeId     String? // future Stripe integration
  seatCount    Int                @default(1)
  seatsUsed    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  plan            SubscriptionPlan   @relation(fields: [planId], references: [id])
  owner           User               @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  seatAssignments SubscriptionSeat[]
}

model SubscriptionSeat {
  id             String     @id @default(cuid())
  subscriptionId String
  studentId      String
  status         SeatStatus @default(active)
  assignedAt     DateTime   @default(now())
  expiresAt      DateTime?
  suspendedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  student      User         @relation(fields: [studentId], references: [id])

  @@unique([subscriptionId, studentId])
}

// =============================================
// USERS, ROLES, PERMISSIONS
// =============================================

model User {
  id                     String    @id @default(cuid())
  username               String    @unique
  email                  String?   @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  displayName            String?
  role                   UserRole  @default(student)
  gradeLevel             String?
  targetTest             String?
  targetScore            Int?
  testDate               DateTime?
  school                 String?
  affiliation            String?
  preferredLang          String    @default("en")
  isActive               Boolean   @default(true)
  emailVerified          Boolean   @default(false)
  requiresPasswordChange Boolean   @default(false)
  loginAttempts          Int       @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  diagnosticCohort       Json? // diagnostic cohort assignment data
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  studentAttempts      StudentAttempt[]
  bookmarks            Bookmark[]
  practiceSessions     PracticeSession[]
  assignments          Assignment[]
  studentAssignments   StudentAssignment[]
  ownedSubscriptions   Subscription[]           @relation("SubscriptionOwner")
  subscriptionSeats    SubscriptionSeat[]
  managedStudents      ManagedStudent[]         @relation("Manager")
  managedBy            ManagedStudent[]         @relation("Student")
  accessRedemptions    AccessCodeRedemption[]
  sessions             Session[]
  accounts             Account[]
  flagReports          QuestionFlag[]
  teacherClasses       ClassTeacher[]           @relation("Teacher")
  studentClasses       ClassStudent[]           @relation("StudentMember")
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  diagnostics          DiagnosticResult[]
  mockExamAttempts     MockExamAttempt[]
  speakingSubmissions  SpeakingSubmission[]
  writingSubmissions   WritingSubmission[]
  teacherReviews       TeacherReview[]
  analyticsSnapshots   AnalyticsSnapshot[]
  subscriptionLicenses SubscriptionLicense[]
}

model ManagedStudent {
  id           String              @id @default(cuid())
  managerId    String
  studentId    String
  relationship ManagedRelationship @default(teacher)
  isActive     Boolean             @default(true)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  manager User @relation("Manager", fields: [managerId], references: [id])
  student User @relation("Student", fields: [studentId], references: [id])

  @@unique([managerId, studentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  deviceInfo   String? // device type, platform
  ipAddress    String?
  isActive     Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================
// CLASSES
// =============================================

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  code        String   @unique // class join code
  subject     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teachers    ClassTeacher[]
  students    ClassStudent[]
  assignments Assignment[]
}

model ClassTeacher {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation("Teacher", fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  student User  @relation("StudentMember", fields: [studentId], references: [id])

  @@unique([classId, studentId])
}

// =============================================
// ASSIGNMENTS
// =============================================

model Assignment {
  id               String         @id @default(cuid())
  classId          String?
  creatorId        String
  title            String
  description      String?
  assignmentType   AssignmentType @default(targetedPractice)
  examId           String?
  subjectId        String?
  domainId         String?
  categoryId       String?
  subcategoryId    String?
  difficulty       Difficulty?
  questionCount    Int?
  timeLimit        Int? // minutes
  attemptLimit     Int? // per question
  dueDate          DateTime?
  showStrategy     Boolean        @default(true)
  showExplanations Boolean        @default(true)
  strictMode       Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  class              Class?               @relation(fields: [classId], references: [id])
  creator            User                 @relation(fields: [creatorId], references: [id])
  questions          AssignmentQuestion[]
  studentAssignments StudentAssignment[]
}

model AssignmentQuestion {
  id           String   @id @default(cuid())
  assignmentId String
  questionId   String
  sortOrder    Int
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])
}

model StudentAssignment {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       AssignmentStatus @default(pending)
  score        Float?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

// =============================================
// PRACTICE SESSIONS & ATTEMPTS
// =============================================

model PracticeSession {
  id                   String        @id @default(cuid())
  userId               String
  sessionType          SessionType   @default(targeted)
  examId               String?
  subjectId            String?
  domainId             String?
  categoryId           String?
  subcategoryId        String?
  difficulty           Difficulty?
  isTimed              Boolean       @default(false)
  timeLimit            Int? // minutes
  timeElapsed          Int? // seconds
  questionCount        Int           @default(0)
  questionsAnswered    Int           @default(0)
  firstAttemptCorrect  Int           @default(0)
  secondAttemptCorrect Int           @default(0)
  score                Float? // percentage
  status               SessionStatus @default(inProgress)
  deviceType           String? // web, android, ios, windows
  deviceId             String?
  startedAt            DateTime      @default(now())
  pausedAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  attempts StudentAttempt[]
}

model StudentAttempt {
  id                String   @id @default(cuid())
  userId            String
  questionId        String
  sessionId         String?
  assignmentId      String?
  attemptNumber     Int      @default(1)
  selectedAnswer    String? // student's answer
  isCorrect         Boolean?
  timeSpent         Int? // seconds
  strategyViewed    Boolean  @default(false)
  hintViewed        Boolean  @default(false)
  explanationViewed Boolean  @default(false)
  wasFlagged        Boolean  @default(false)
  confidence        Int? // 1-5
  createdAt         DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  question Question         @relation(fields: [questionId], references: [id])
  session  PracticeSession? @relation(fields: [sessionId], references: [id])
}

// =============================================
// BOOKMARKS & FLAGS
// =============================================

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model QuestionFlag {
  id          String     @id @default(cuid())
  userId      String
  questionId  String
  flagType    FlagType   @default(error)
  description String
  status      FlagStatus @default(pending)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
}

// =============================================
// MASTERY
// =============================================

model Mastery {
  id                   String       @id @default(cuid())
  userId               String
  subjectId            String
  domainId             String?
  categoryId           String?
  subcategoryId        String?
  microSkillId         String?
  microSkill           String?
  difficulty           Difficulty?
  level                MasteryLevel @default(notAssessed)
  firstAttemptCount    Int          @default(0)
  firstAttemptCorrect  Int          @default(0)
  secondAttemptCount   Int          @default(0)
  secondAttemptCorrect Int          @default(0)
  totalAttempts        Int          @default(0)
  totalCorrect         Int          @default(0)
  totalTimeSpent       Int          @default(0) // seconds
  lastPracticedAt      DateTime?
  confidence           Float?       @default(0.0)
  needsReview          Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  microSkillRef MicroSkill? @relation(fields: [microSkillId], references: [id])

  @@unique([userId, subcategoryId, microSkill, difficulty])
  @@unique([userId, categoryId, subcategoryId, microSkill, difficulty])
}

// =============================================
// ENTERPRISE: DIAGNOSTIC MODELS
// =============================================

model DiagnosticExam {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  examType    ExamType @default(SAT)
  sections    Json? // [{ "name": "Reading", "questionCount": 52, "timeLimit": 65 }, ...]
  duration    Int? // minutes
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  results DiagnosticResult[]
}

model DiagnosticResult {
  id                    String   @id @default(cuid())
  userId                String
  examId                String?
  subjectId             String?
  skillId               String? // references MicroSkill
  diagnosticExamId      String? // references DiagnosticExam
  score                 Float?
  baseline              Float? // baseline estimate
  readiness             String? // not_ready, developing, ready, exceeded
  recommendedCurriculum String?
  learningGaps          Json? // [{ "skill": "...", "gap": 0.4 }, ...]
  estimatedScore        Int? // estimated test score
  completedAt           DateTime @default(now())
  createdAt             DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  exam           Exam?           @relation(fields: [examId], references: [id])
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  skill          MicroSkill?     @relation(fields: [skillId], references: [id])
  diagnosticExam DiagnosticExam? @relation(fields: [diagnosticExamId], references: [id])
}

// =============================================
// ENTERPRISE: MOCK EXAMS
// =============================================

model MockExam {
  id         String   @id @default(cuid())
  examId     String
  name       String
  code       String   @unique
  module     Json? // [{ "name": "Module 1", "questionCount": 22, "timeLimit": 35 }, ...]
  duration   Int? // minutes
  isOfficial Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exam     Exam              @relation(fields: [examId], references: [id])
  attempts MockExamAttempt[]
}

model MockExamAttempt {
  id         String    @id @default(cuid())
  userId     String
  mockExamId String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  scores     Json? // [{ "module": "Module 1", "score": 18, "total": 22 }, ...]
  answers    Json? // [{ "questionId": "...", "answer": "A", "isCorrect": true, "timeSpent": 45 }, ...]
  completed  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  mockExam MockExam @relation(fields: [mockExamId], references: [id])
}

// =============================================
// ENTERPRISE: SPEAKING & WRITING SUBMISSIONS
// =============================================

model SpeakingSubmission {
  id                String   @id @default(cuid())
  userId            String
  promptId          String
  audioUrl          String?
  transcription     String?
  fluency           Float?
  grammar           Float?
  vocabulary        Float?
  pronunciation     Float?
  coherence         Float?
  estimatedScore    Float?
  teacherReviewed   Boolean  @default(false)
  teacherScore      Float?
  teacherNotes      String?
  teacherApproved   Boolean  @default(false)
  releasedToStudent Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model WritingSubmission {
  id                String   @id @default(cuid())
  userId            String
  promptId          String
  content           String?
  wordCount         Int?
  secureSession     Json? // browser fingerprint, session token, checksums
  rubricScores      Json? // [{ "criterion": "organization", "score": 4, "max": 6 }, ...]
  estimatedScore    Float?
  aiFeedback        Json? // { "strengths": [...], "weaknesses": [...], "suggestions": [...] }
  teacherReviewed   Boolean  @default(false)
  teacherScore      Float?
  teacherNotes      String?
  teacherApproved   Boolean  @default(false)
  releasedToStudent Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model TeacherReview {
  id             String         @id @default(cuid())
  submissionType SubmissionType
  submissionId   String
  teacherId      String
  status         ReviewStatus   @default(pending)
  score          Float?
  notes          String?
  aiFeedback     Json? // AI assessment snapshot at time of review
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher User @relation(fields: [teacherId], references: [id])
}

// =============================================
// ENTERPRISE: ANALYTICS SNAPSHOTS
// =============================================

model AnalyticsSnapshot {
  id          String        @id @default(cuid())
  userId      String
  type        AnalyticsType @default(student)
  data        Json // full snapshot payload
  period      String // "daily", "weekly", "monthly", "custom"
  generatedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
}

// =============================================
// ENTERPRISE: SUBSCRIPTION LICENSES
// =============================================

model SubscriptionLicense {
  id          String                    @id @default(cuid())
  userId      String
  planId      String
  type        SubscriptionLicenseType   @default(individual)
  maxStudents Int?
  startDate   DateTime                  @default(now())
  endDate     DateTime?
  status      SubscriptionLicenseStatus @default(active)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// =============================================
// NOTIFICATIONS
// =============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // assignment, reminder, progress, system
  title     String
  body      String?
  data      Json? // additional data
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String
  assignmentReminders Boolean  @default(true)
  deadlineReminders   Boolean  @default(true)
  studyReminders      Boolean  @default(false)
  weeklyReports       Boolean  @default(true)
  teacherMessages     Boolean  @default(true)
  quietHoursStart     String? // "22:00"
  quietHoursEnd       String? // "07:00"
  pushEnabled         Boolean  @default(true)
  emailEnabled        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId])
}

// =============================================
// AUDIT LOG
// =============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // user.created, question.published, seat.assigned, etc.
  entity    String? // question, user, subscription, etc.
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
